# ============================================================================
# Polymanager — environment configuration
# Copy to `.env` and fill in. NEVER commit your real `.env`.
# NEVER paste your private key into any chat/LLM prompt.
# ============================================================================

# --- Polymarket credentials (only needed for shadow/live modes) ------------
# Wallet private key used to SIGN orders. Stays local. Never logged.
POLYMARKET_PRIVATE_KEY="never_commit_this"
# Proxy/funder address (the Polymarket-deposited wallet). Required for
# signature_type 1 (email/magic) and 2 (browser wallet). Leave blank for EOA.
POLYMARKET_FUNDER_ADDRESS=""
# Signature type: 0 = EOA, 1 = Email/Magic proxy, 2 = Browser wallet (Safe).
POLYMARKET_SIGNATURE_TYPE="1"

# --- API hosts (defaults are correct for Polygon mainnet) ------------------
POLYMARKET_HOST="https://clob.polymarket.com"
GAMMA_HOST="https://gamma-api.polymarket.com"
DATA_HOST="https://data-api.polymarket.com"
CHAIN_ID="137"

# --- Claude reasoning layer ------------------------------------------------
ANTHROPIC_API_KEY="your_claude_key"
REASONER_MODEL="claude-sonnet-4-6"
# Set to "true" to skip the LLM call entirely (reasoner auto-allows). Useful
# for offline paper testing without an Anthropic key. Never use in live mode.
REASONER_DISABLED="false"

# --- Bot mode --------------------------------------------------------------
# research | paper | shadow | tiny_live | live | paused
# NEVER defaults to live. Paper is the safe default.
BOT_MODE="paper"

# --- Bankroll (USDC) -------------------------------------------------------
BANKROLL_USD="1000"

# --- Account-level risk limits (fractions of bankroll) ---------------------
MAX_ACCOUNT_EXPOSURE_PCT="0.25"
MAX_MARKET_EXPOSURE_PCT="0.02"
MAX_DAILY_LOSS_PCT="0.04"
MAX_OPEN_ORDERS="20"
MIN_EDGE_BPS="35"

# --- Per-strategy position caps (fractions of bankroll) --------------------
MAX_MOMENTUM_POSITION_PCT="0.005"
MAX_NEAR_CERTAINTY_POSITION_PCT="0.01"
MAX_TAIL_POSITION_PCT="0.003"
MAX_TOTAL_TAIL_BOOK_PCT="0.05"
MAX_ARBITRAGE_POSITION_PCT="0.02"

# --- Market discovery filters ----------------------------------------------
MIN_LIQUIDITY_USD="5000"
MIN_24H_VOLUME_USD="1000"
MAX_SPREAD="0.03"
MAX_ORDER_BOOK_AGE_SECONDS="2"
STALE_ORDER_CANCEL_SECONDS="10"

# --- Execution / loop ------------------------------------------------------
LOOP_INTERVAL_SECONDS="2.0"
MAX_API_LATENCY_MS="1500"
ORDER_REJECTION_RATE_LIMIT="0.25"

# --- Alpha / external signals ----------------------------------------------
# Wire the crypto-threshold provider: prices "Will BTC be above $X by Y?"
# markets from live spot, feeding momentum / near-certainty / cheap-tail.
# Arbitrage needs no external alpha. Default off.
ENABLE_CRYPTO_ALPHA="false"
ALPHA_PRICE_HOST="https://api.coinbase.com"
ALPHA_CATALYST_HORIZON_DAYS="7"

# --- Storage ---------------------------------------------------------------
DB_PATH="data/polymanager.db"
LOG_DIR="logs"
LOG_LEVEL="INFO"
